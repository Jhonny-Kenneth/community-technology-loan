# Community Technology Loan API — production environment template
#
# Do not rename and commit this file as .env.production. Store real values in
# Render > Service > Environment, or in another production secret manager.

NODE_ENV=production
HOST=0.0.0.0
PORT=10000

# Render Postgres internal connection string. Never use the external URL when
# the API and database are in the same Render region.
DATABASE_URL=postgresql://RENDER_USER:RENDER_PASSWORD@RENDER_INTERNAL_HOST:5432/RENDER_DATABASE

# Generate independently for each environment. Minimum 32 characters.
# Example command: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Exact comma-separated HTTPS origins; no paths, trailing slashes, or wildcard.
CORS_ORIGINS=https://YOUR_FRONTEND_HOST.onrender.com

# Optional OpenTelemetry export. Leave OTEL_EXPORTER_OTLP_ENDPOINT unset if no
# production collector/provider is configured; the API will run without it.
# OTEL_SERVICE_NAME=community-technology-loan-api
# OTEL_EXPORTER_OTLP_ENDPOINT=https://YOUR_OTLP_ENDPOINT
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://YOUR_OTLP_ENDPOINT/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://YOUR_OTLP_ENDPOINT/v1/logs
# OTEL_LOG_LEVEL=info
